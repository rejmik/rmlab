# Zkopírujte do .env a doplňte
LF_SECRET_KEY=zmente-na-dlouhy-nahodny-retezec
GOOGLE_PLACES_API_KEY=
# LF_CLAIM_DAYS=7
# LF_ENRICH_MAX=200
# LF_CACHE_DAYS=30
# LF_MASS_ADDRESS=15
# Návrhy textů webů přes Claude API (nepovinné – bez klíče se texty předvyplní šablonou)
ANTHROPIC_API_KEY=
# LF_AI_MODEL=claude-sonnet-5-5

# --- veřejný server (Railway) ---
# LF_DB_PATH=/data/leadfinder.sqlite   # v Dockerfile už nastaveno; /data = trvalý disk
# LF_HTTPS=1                           # cookie přihlášení jen přes HTTPS
# LF_ROOT_REDIRECT=/nase-crm/          # na doméně CRM přesměrovat „/“ rovnou do aplikace
# LF_ADMIN_USER=lukas                  # první admin – založí se, když je databáze prázdná
# LF_ADMIN_NAME=Lukáš
# LF_ADMIN_PASSWORD=
# LF_AUTO_IMPORT=1                     # stáhnout a naimportovat RES + RÚIAN na pozadí (desítky minut)
# LF_LOGIN_MAX_FAILS=10                # max. chybných přihlášení z jedné IP za 15 minut

# --- poptávky z webu: upozornění e-mailem ---
# LF_NOTIFY_TO=rejmil.web@gmail.com
# LF_RESEND_API_KEY=re_...              # https://resend.com – doporučeno, Railway blokuje SMTP
# LF_MAIL_FROM=RM Lab <onboarding@resend.dev>
# nebo SMTP (na Railway Hobby obvykle zablokované):
# LF_SMTP_HOST=  LF_SMTP_PORT=587  LF_SMTP_USER=  LF_SMTP_PASSWORD=
